# Copie este arquivo para ".env" e preencha com os seus valores.
# O arquivo .env NÃO deve ser versionado (está no .gitignore).

MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU_CLUSTER.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DATABASE=pediupatrao

# Usuário administrador criado na primeira execução
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Dashboard: minutos para um pedido em andamento ser considerado atrasado
DASHBOARD_MINUTOS_ATRASO=40

# true = cria pedidos de demonstração (últimos 60 dias) na próxima execução, uma única vez
APP_DEMO_CARREGAR=false
